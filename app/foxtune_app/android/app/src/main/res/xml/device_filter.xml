<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices FoxTune offers to open when one is plugged in.

     Android matches on vendor ID and asks "Open FoxTune when this is
     connected?". Ticking "always" grants USB permission for the device
     permanently, so connecting no longer prompts every time.

     These are the same vendors EcuPort.knownEcuVendorIds sorts to the top
     of the port picker (packages/foxtune_transport), and a test keeps the
     two lists identical. IDs are decimal, as Android requires. -->
<resources>
    <!-- 0x2341 Arduino -->
    <usb-device vendor-id="9025" />
    <!-- 0x1A86 CH340/CH341 clones -->
    <usb-device vendor-id="6790" />
    <!-- 0x0403 FTDI -->
    <usb-device vendor-id="1027" />
    <!-- 0x10C4 Silicon Labs CP210x -->
    <usb-device vendor-id="4292" />
    <!-- 0x1EAF Leaflabs Maple / STM32 -->
    <usb-device vendor-id="7855" />
    <!-- 0x0483 STMicroelectronics -->
    <usb-device vendor-id="1155" />
    <!-- 0x16C0 Teensy -->
    <usb-device vendor-id="5824" />
</resources>
