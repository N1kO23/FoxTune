<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed. FoxTune opens serial ports, connects to ECUs and
	     downloads definitions over the network, and reads and writes tune
	     files wherever the user keeps them. The sandbox is what the Mac App
	     Store requires, and FoxTune is distributed directly instead. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
